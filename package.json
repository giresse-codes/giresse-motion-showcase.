{
  "name": "giresse-motion-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "Vidéos publicitaires Remotion « un seul prompt » pour promouvoir les services de Giresse.",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "build": "npm run render:all",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "sfx": "node scripts/generate-audio.mjs",
    "sfx:gmotion": "node scripts/generate-gmotion-audio.mjs",
    "render:gmotion": "remotion render GMotionPromo out/gmotion-promo.mp4",
    "render:gmotion2": "remotion render GMotionPromo2 out/gmotion-promo-2.mp4",
    "render": "remotion render",
    "render:motion:vertical": "remotion render MotionDesignPromo-Vertical out/MotionDesignPromo-9x16.mp4",
    "render:motion:landscape": "remotion render MotionDesignPromo-Landscape out/MotionDesignPromo-16x9.mp4",
    "render:web:vertical": "remotion render WebDevPromo-Vertical out/WebDevPromo-9x16.mp4",
    "render:web:landscape": "remotion render WebDevPromo-Landscape out/WebDevPromo-16x9.mp4",
    "render:coding:vertical": "remotion render CodingPromo-Vertical out/CodingPromo-9x16.mp4",
    "render:coding:landscape": "remotion render CodingPromo-Landscape out/CodingPromo-16x9.mp4",
    "render:all": "node scripts/render-all.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/motion-blur": "4.0.539",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "typescript": "5.9.3"
  }
}
